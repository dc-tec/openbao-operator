{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "grey",
                  "index": 0,
                  "text": "None"
                },
                "1": {
                  "color": "blue",
                  "index": 1,
                  "text": "Running"
                },
                "2": {
                  "color": "green",
                  "index": 2,
                  "text": "Success"
                },
                "3": {
                  "color": "red",
                  "index": 3,
                  "text": "Failed"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "grey",
                "value": null
              },
              {
                "color": "blue",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(openbao_upgrade_status{exported_namespace=\"$namespace\", name=\"$cluster\"})",
          "refId": "A"
        }
      ],
      "title": "Upgrade Status",
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "grey",
            "mode": "fixed"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "grey",
                  "index": 0,
                  "text": "None"
                },
                "1": {
                  "color": "blue",
                  "index": 1,
                  "text": "Running"
                },
                "2": {
                  "color": "green",
                  "index": 2,
                  "text": "Success"
                },
                "3": {
                  "color": "red",
                  "index": 3,
                  "text": "Failed"
                }
              },
              "type": "value"
            }
          ],
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 18,
        "x": 6,
        "y": 0
      },
      "id": 25,
      "options": {
        "legend": {
          "displayMode": "hidden",
          "placement": "bottom",
          "showLegend": false
        },
        "mergeValues": true,
        "showValue": "always"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(openbao_upgrade_status{exported_namespace=\"$namespace\", name=\"$cluster\"}) or vector(0)",
          "legendFormat": "Upgrade status",
          "refId": "A"
        }
      ],
      "title": "Upgrade Status (History)",
      "type": "state-timeline"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "id": 17,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(openbao_upgrade_pods_completed{exported_namespace=\"$namespace\", name=\"$cluster\"})",
          "legendFormat": "Pods Completed",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(openbao_upgrade_pods_total{exported_namespace=\"$namespace\", name=\"$cluster\"})",
          "legendFormat": "Total Pods",
          "refId": "B"
        }
      ],
      "title": "Upgrade Progress (Pods Completed vs Total)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 8
      },
      "id": 26,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(openbao_upgrade_partition{exported_namespace=\"$namespace\", name=\"$cluster\"})",
          "refId": "A"
        }
      ],
      "title": "Upgrade Partition",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 6,
        "y": 8
      },
      "id": 7,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.50, sum(increase(openbao_upgrade_duration_seconds_bucket{exported_namespace=\"$namespace\", name=\"$cluster\"}[$__range])) by (le, exported_namespace, name))",
          "legendFormat": "Total Duration (p50)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum(increase(openbao_upgrade_duration_seconds_bucket{exported_namespace=\"$namespace\", name=\"$cluster\"}[$__range])) by (le, exported_namespace, name))",
          "legendFormat": "Total Duration (p95)",
          "refId": "B"
        }
      ],
      "title": "Upgrade Duration",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 8,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(openbao_upgrade_stepdown_total{exported_namespace=\"$namespace\", name=\"$cluster\"}[5m]))",
          "legendFormat": "Step-downs",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(openbao_upgrade_stepdown_failures_total{exported_namespace=\"$namespace\", name=\"$cluster\"}[5m]))",
          "legendFormat": "Failures",
          "refId": "B"
        }
      ],
      "title": "Upgrade Step-Down Operations",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 15,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.50, sum(increase(openbao_upgrade_pod_duration_seconds_bucket{exported_namespace=\"$namespace\", name=\"$cluster\"}[$__range])) by (le, exported_namespace, name, exported_pod))",
          "legendFormat": "{{exported_pod}} (p50)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum(increase(openbao_upgrade_pod_duration_seconds_bucket{exported_namespace=\"$namespace\", name=\"$cluster\"}[$__range])) by (le, exported_namespace, name, exported_pod))",
          "legendFormat": "{{exported_pod}} (p95)",
          "refId": "B"
        }
      ],
      "title": "Per-Pod Upgrade Duration",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "id": 18,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(openbao_upgrade_success_total{exported_namespace=\"$namespace\", name=\"$cluster\"}[1h])) by (strategy)",
          "legendFormat": "Success ({{strategy}})",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(openbao_upgrade_failure_total{exported_namespace=\"$namespace\", name=\"$cluster\"}[1h])) by (strategy)",
          "legendFormat": "Failure ({{strategy}})",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(openbao_upgrade_rollback_total{exported_namespace=\"$namespace\", name=\"$cluster\"}[1h])) by (strategy)",
          "legendFormat": "Rollback ({{strategy}})",
          "refId": "C"
        }
      ],
      "title": "Upgrade Success/Failure/Rollback",
      "type": "timeseries"
    }
  ],
  "preload": false,
  "refresh": "30s",
  "schemaVersion": 42,
  "tags": [
    "openbao",
    "operator",
    "kubernetes"
  ],
