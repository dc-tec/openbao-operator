# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/*
Dockerfile.cross

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out
*.xml

# Go workspace file
go.work

# Local development files
.DS_Store
.gocache
.pnpm-store/
node_modules/

# Kubernetes Generated files - skip generated files, except for vendored files
!vendor/**/zz_generated.*

# editor and IDE paraphernalia
.idea
.vscode
*.swp
*.swo
*~

# Kubeconfig might contain secrets
*.kubeconfig

# Environment variables
.env
.envrc

# Documentation build output
site/*
website/public/

# Release workflow outputs (generated locally during validation)
dist/install.yaml
dist/crds.yaml
dist/checksums.txt
dist/sbom-*.spdx.json
dist/architecture/
dist/bench/
dist/fuzz/
dist/licenses/
dist/perf/
dist/semgrep/
dist/test/
dist/mutation/
tmp/air/
__debug*
artifacts/
