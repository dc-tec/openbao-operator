{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "prepare:contribute": "node ./scripts/sync-contribute-docs.mjs",
    "prepare:releases": "node ./scripts/generate-releases.mjs",
    "prepare:site": "pnpm run prepare:contribute && pnpm run prepare:releases",
    "docusaurus": "docusaurus",
    "start": "pnpm run prepare:site && docusaurus start --host 0.0.0.0 --port 8000 --no-open",
    "build": "pnpm run typecheck && pnpm run prepare:site && docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "pnpm run prepare:site && docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "version:docs": "node ./scripts/snapshot-version.mjs",
    "refresh:docs-version": "node ./scripts/refresh-version.mjs",
    "verify:docs-version": "node ./scripts/verify-docs-version.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@cmfcmf/docusaurus-search-local": "^2.0.1",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/plugin-client-redirects": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "pnpm": {
    "overrides": {
      "lodash": "4.18.1",
      "lodash-es": "4.18.1",
      "serialize-javascript": "7.0.5"
    }
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=22.0 <23"
  }
}
